# Copy to .env.local (gitignored) and fill in values.
#
# IMPORTANT — Expo env-var conventions (M5 audit finding):
# - Anything prefixed EXPO_PUBLIC_ is INLINED INTO THE CLIENT BUNDLE at build
#   time and is readable by anyone who inspects the app. Only put values here
#   that are safe to publish (e.g., Stripe publishable key, Sentry DSN,
#   Google Places API key — because those are already scoped/restricted).
# - SECRETS (Stripe secret key, Supabase service-role key, PayPal secret,
#   Sentry auth token) MUST go into EAS Secrets (`eas secret:create`) and
#   Supabase Edge Function secrets — NEVER in this file, NEVER with an
#   EXPO_PUBLIC_ prefix.

# Sentry DSN — public by design; obtain from Sentry project settings
EXPO_PUBLIC_SENTRY_DSN=

# Supabase (added in Epic 2) — public/anon key only
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (added in Epic 7) — publishable key only (pk_*)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Places (added in Epic 7) — must be restricted to your bundle IDs
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
