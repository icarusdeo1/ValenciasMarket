{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "cache": { "disabled": false }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "cache": { "disabled": false }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "cache": { "disabled": false }
    }
  },
  "submit": {
    "production": {}
  }
}
